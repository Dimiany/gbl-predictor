# Copy this file to .env and fill in the values.
# .env is gitignored — it stays local. .env.example is checked in as a template.

# RapidAPI key for the FlashScore subscription.
# Find it at: rapidapi.com → your subscriptions → FlashScore → Header Parameters → x-rapidapi-key
RAPIDAPI_KEY=your-rapidapi-key-here

# FlashScore identifiers for the Greek A1 (GBL).
# Hit /tournaments/list on the API and filter for Greece basketball if you don't have these.
FLASHSCORE_TOURNAMENT_TEMPLATE_ID=
FLASHSCORE_SEASON_ID=

# Optional address for the Contact page's mailto fallback (page opened as a file).
GBL_CONTACT_EMAIL=

# ---- Public site (Firebase). In GitHub Actions these come from repository
# variables; locally they're only needed to test a live/preview build.
# local | live | preview  (the desktop app is always "local")
GBL_SITE_MODE=local
# Firebase web config: public by design, access is set by firestore.rules.
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=

# 1 = GitHub Actions does the sync + prediction logging; the desktop app's
# Refresh pulls the cloud's data with git instead of calling the API.
GBL_CLOUD_SYNC=
